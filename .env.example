# Usuario propietario: solo para migraciones y scripts de administración.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/finanzas_dev

# Usuario de la aplicación: sin privilegios para saltarse Row-Level Security.
# La contraseña se fija con `npm run db:roles`.
APP_DB_PASSWORD=cambia-esta-clave
DATABASE_URL=postgres://finanzas_app:cambia-esta-clave@localhost:5432/finanzas_dev

# Better Auth: secreto de 32+ caracteres (openssl rand -base64 32) y URL pública.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Carpeta donde se guardan los documentos subidos (fuera de /public).
# En producción se sustituirá por un almacenamiento S3 en la UE.
STORAGE_DIR=./storage
